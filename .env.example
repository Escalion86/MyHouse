# Copy to .env on the VPS. Never commit the filled .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=https://house.escalion.ru
HA_URL=https://home.escalion.ru

# Use your MongoDB username/password and the database where that user was created.
# URL-encode special characters in username/password. authSource may be admin.
MONGODB_URI=mongodb://myhouse:CHANGE_ME@127.0.0.1:27017/myhouse?authSource=myhouse
MONGODB_DB=myhouse

ADMIN_USERNAME=owner
# Generate with: npm run password:hash
ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Back up this key together with MongoDB. Keep it unchanged across deployments.
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
